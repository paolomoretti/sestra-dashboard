rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Widgets collection
    match /widgets/{widgetId} {
      // Allow read/write for authenticated users
      allow read, write: if request.auth != null;
      

    }
    
    // UI settings collection
    match /ui/{document} {
      // Allow read/write for authenticated users
      allow read, write: if request.auth != null;
      

    }
  }
}